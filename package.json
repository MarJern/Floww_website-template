{
  "name": "floww-media-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "seed": "pnpm --filter @floww/factors seed",
    "worker": "pnpm --filter @floww/worker dev",
    "db:generate": "pnpm --filter @floww/db db:generate",
    "db:push": "pnpm --filter @floww/db db:push"
  },
  "devDependencies": {
    "turbo": "^2.4.0",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@9.15.0"
}
